MAX_EVENT_PAYLOAD_BYTES=65536
MAX_PENDING_HTTP_GLOBAL=512
MAX_PENDING_HTTP_PER_DEVICE=32
MAX_TUNNEL_WS_GLOBAL=256
MAX_TUNNEL_WS_PER_DEVICE=16
